PORT=8080
MONGO_URI=mongodb://localhost:27017/rastriya-khadya-bank
JWT_SECRET=replace-with-a-strong-secret
JWT_ACCESS_EXPIRY=7d

# Frontend origin(s) for CORS. Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# API base URL used in verification email links
BACKEND_URL=http://localhost:8080

# Frontend URL used for email verification result redirects
FRONTEND_URL=http://localhost:5175

# SMTP configuration (required for real email delivery)
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com
# SMTP_FROM_NAME=rastriya-khadya-bank-mart
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
